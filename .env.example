# === 必须配的 ===
SECRET_KEY=change-me-to-32-char-random-hex
ADMIN_EMAIL=annachow250815@gmail.com

# === 数据库 (SQLAlchemy URL,切换数据库改这一行即可) ===
DATABASE_URL=sqlite:///./data/app.db
# 切换 MySQL:    DATABASE_URL=mysql+pymysql://user:pass@host:3306/lit_share
# 切换 Postgres: DATABASE_URL=postgresql+psycopg://user:pass@host:5432/lit_share

# === 邮件 (MVP 留空走控制台 stub) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@xpro.work

# === 业务参数 (system_settings 表会覆盖这里,这里仅是首次初始化默认值) ===
SIGNIN_POINTS=10
REQUEST_TIMEOUT_DAYS=7
CONFIRM_WINDOW_HOURS=48
MAX_PDF_SIZE_MB=50
MAX_ACTIVE_REQUESTS=3
SAME_JOURNAL_MONTHLY_LIMIT=4
REPORT_THRESHOLD=3
REPORTER_MIN_HELPS=30
PDF_DESENSITIZE_ENABLED=true

# === 站点文案 ===
SITE_TITLE=公益文献互助
SITE_SLOGAN=输入标题、作者、年份,全社区帮你找全文

# === 运行参数 ===
APP_HOST=127.0.0.1
APP_PORT=10800
APP_BASE_PATH=/preview/lit
DEBUG=false
